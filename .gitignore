# ---- Home Assistant --------------------------------------------------------
# Never commit a real HA config: secrets.yaml holds credentials, and .storage
# holds Alarmo's user codes in clear text. Nothing from a live config belongs
# in a blueprint repo.
secrets.yaml
.storage/
*.db
*.db-shm
*.db-wal
home-assistant.log*
home-assistant_v2.db*
.HA_VERSION
deps/
tts/

# ---- Scratch ---------------------------------------------------------------
*.bak
*.orig
*.rej
*.tmp
.env
